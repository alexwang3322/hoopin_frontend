# Copy to .env.local (already gitignored via the `*.local` rule) to override.
# Defaults to the local backend dev server (see ../backend/README.md) so
# `npm run dev` works with zero setup.
VITE_API_BASE_URL=http://localhost:8787/v1

# Clerk Dashboard -> API Keys -> Publishable key. Safe to expose client-side
# by design (Clerk docs) — it's baked into the bundle either way, no secret
# in it. Required for sign-in/sign-up/sign-out to work at all.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_c2Vuc2libGUtZ2Vja28tMjUzNy5jbGVyay5hY2NvdW50cy5kZXYk
